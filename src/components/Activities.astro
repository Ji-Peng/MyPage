---
import { programCommittee, talks, software, projects } from '../data/activities';
---

<section id="activities" class="scroll-mt-20 space-y-6 pt-8">
  <div class="flex items-center justify-between pb-2 border-b border-slate-200 dark:border-slate-800">
    <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-slate-100 flex items-center gap-2">
      <svg width="20" height="20" class="w-5 h-5 text-indigo-600 dark:text-indigo-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
      </svg>
      Professional Activities & Service
    </h2>
    <span class="text-xs font-mono text-slate-500 dark:text-slate-400">PC · Talks · Code · Industry</span>
  </div>

  <!-- 1. Program Committee -->
  <div class="space-y-3">
    <h3 class="text-sm font-bold uppercase tracking-wider font-mono text-slate-500 dark:text-slate-400 flex items-center gap-2">
      <span>Program Committee (PC)</span>
    </h3>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
      {
        programCommittee.map((item) => (
          <div class="p-3 rounded-lg border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900/60 shadow-2xs hover:border-slate-300 dark:hover:border-slate-700 transition-colors">
            <div class="flex items-center justify-between gap-1">
              <span class="text-sm font-bold text-slate-900 dark:text-slate-100">
                {item.venue}
              </span>
              <span class="font-mono text-xs px-2 py-0.5 rounded font-semibold bg-indigo-50 text-indigo-700 dark:bg-indigo-950/60 dark:text-indigo-300 border border-indigo-200/70 dark:border-indigo-800/70">
                {item.year}
              </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
              {item.role || 'Program Committee Member'}
            </p>
          </div>
        ))
      }
    </div>
  </div>

  <!-- 2. Invited Talks -->
  <div class="space-y-3 pt-2">
    <h3 class="text-sm font-bold uppercase tracking-wider font-mono text-slate-500 dark:text-slate-400 flex items-center gap-2">
      <span>Invited Talks</span>
    </h3>

    <div class="space-y-3">
      {
        talks.map((talk) => (
          <div class="p-3.5 sm:p-4 rounded-xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900/60 shadow-2xs space-y-3">
            <div class="space-y-1">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="font-bold text-slate-900 dark:text-slate-100 text-sm sm:text-base">
                  {talk.event}
                </span>
                <span class="font-mono text-xs px-2 py-0.5 rounded font-medium bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  {talk.date}
                </span>
              </div>
              <p class="text-xs sm:text-sm font-medium text-slate-800 dark:text-slate-200">
                {talk.title}
              </p>
              <p class="text-xs text-slate-500 dark:text-slate-400 flex items-center gap-1">
                <svg width="14" height="14" class="w-3.5 h-3.5 flex-shrink-0 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                </svg>
                <span>{talk.location}</span>
              </p>
            </div>

            <!-- Action links for talk -->
            <div class="flex flex-wrap items-center gap-2 pt-0.5">
              {talk.slides && (
                <a
                  href={talk.slides}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-btn"
                >
                  <svg width="12" height="12" class="w-3 h-3 text-red-500" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-9.5 8.5h-2V13H9c.55 0 1-.45 1-1v-.5c0-.55-.45-1-1-1zm0-3h-2V10H9c.55 0 1-.45 1-1v-.5c0-.55-.45-1-1-1zm6 3h-2V13h1.5c.55 0 1-.45 1-1v-.5c0-.55-.45-1-1-1zm0-3h-2V10h1.5c.55 0 1-.45 1-1v-.5c0-.55-.45-1-1-1z" />
                  </svg>
                  <span>Slides</span>
                </a>
              )}
              {talk.link && (
                <a
                  href={talk.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-btn"
                >
                  <span>Event Page</span>
                  <svg width="10" height="10" class="w-2.5 h-2.5 opacity-70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                  </svg>
                </a>
              )}
            </div>

            <!-- Photos preview -->
            {talk.pictures && talk.pictures.length > 0 && (
              <div class="pt-1">
                <p class="text-[11px] font-mono text-slate-500 dark:text-slate-400 mb-2">Photos:</p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                  {talk.pictures.map((pic, idx) => (
                    <a
                      href={pic}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group block relative overflow-hidden rounded-lg border border-slate-200 dark:border-slate-800 shadow-2xs bg-slate-100 dark:bg-slate-800"
                    >
                      <img
                        src={pic}
                        alt={`${talk.event} picture ${idx + 1}`}
                        class="w-full h-44 object-cover object-center group-hover:scale-102 transition-transform duration-300"
                        loading="lazy"
                      />
                      <div class="absolute inset-0 bg-slate-900/0 group-hover:bg-slate-900/20 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
                        <span class="px-2 py-1 rounded bg-black/75 text-white text-[11px] font-mono">
                          View full size ↗
                        </span>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>

  <!-- 3. Software & Open Source -->
  <div class="space-y-3 pt-2">
    <h3 class="text-sm font-bold uppercase tracking-wider font-mono text-slate-500 dark:text-slate-400 flex items-center gap-2">
      <span>Software & Open Source Contributions</span>
    </h3>

    <div class="space-y-2.5">
      {
        software.map((item) => (
          <div class="p-3.5 rounded-xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900/60 shadow-2xs space-y-2">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <a
                  href={item.prUrl || item.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-bold text-sm text-slate-900 dark:text-slate-100 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
                >
                  {item.title}
                </a>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-emerald-50 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
                  <svg width="12" height="12" class="w-3 h-3 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                  </svg>
                  <span>Merged PR #{item.prNumber}</span>
                </span>
              </div>
            </div>

            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              {item.description}
            </p>

            <div class="flex flex-wrap items-center gap-2 pt-0.5">
              <a
                href={item.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="link-btn"
              >
                <svg width="12" height="12" class="w-3 h-3 text-slate-700 dark:text-slate-300" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                </svg>
                <span>{item.repo}</span>
              </a>

              {item.prUrl && (
                <a
                  href={item.prUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-btn"
                >
                  <span>PR #{item.prNumber}</span>
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- 4. Industrial Research Projects -->
  <div class="space-y-3 pt-2">
    <h3 class="text-sm font-bold uppercase tracking-wider font-mono text-slate-500 dark:text-slate-400 flex items-center gap-2">
      <span>Industrial Research Projects</span>
    </h3>

    <div class="grid grid-cols-1 gap-3">
      {
        projects.map((proj) => (
          <div class="p-3.5 sm:p-4 rounded-xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900/60 shadow-2xs space-y-2">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-2">
              <div class="flex flex-wrap items-baseline gap-2">
                <h4 class="font-bold text-sm sm:text-base text-slate-900 dark:text-slate-100">
                  {proj.title}
                </h4>
                {proj.companyUrl ? (
                  <a
                    href={proj.companyUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline"
                  >
                    @{proj.company}
                  </a>
                ) : (
                  <span class="text-xs font-semibold text-indigo-600 dark:text-indigo-400">
                    @{proj.company}
                  </span>
                )}
              </div>
              <span class="font-mono text-xs px-2 py-0.5 rounded font-medium bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 self-start sm:self-auto">
                {proj.period}
              </span>
            </div>

            {proj.role && (
              <p class="text-xs font-mono text-slate-500 dark:text-slate-400">
                Role: {proj.role} {proj.location && `· ${proj.location}`}
              </p>
            )}

            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed text-left sm:text-justify">
              {proj.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
