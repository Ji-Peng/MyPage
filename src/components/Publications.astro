---
import publications, { selectedPublications } from '../data/publications';
import { coauthorLinks } from '../data/coauthors';
import ArtifactBadge from './ArtifactBadge.astro';

// Group all publications by year descending
const years = Array.from(new Set(publications.map((p) => p.year))).sort((a, b) => b - a);

const totalCount = publications.length;
const selectedCount = selectedPublications.length;
---

<section id="publications" class="scroll-mt-20 space-y-5 pt-8">
  <!-- Section Header & Filter Tabs -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-200 dark:border-slate-800">
    <div class="space-y-0.5">
      <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-slate-100 flex items-center gap-2">
        <svg width="20" height="20" class="w-5 h-5 text-indigo-600 dark:text-indigo-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
        </svg>
        Publications
      </h2>
      <p class="text-xs text-slate-500 dark:text-slate-400">
        Top-tier security & architecture venues (USENIX Security, MICRO, ACM CCS, CHES/TCHES)
      </p>
    </div>

    <!-- Filter Buttons (Tabs) -->
    <div class="inline-flex p-1 rounded-lg bg-slate-100 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/80 self-start sm:self-auto text-xs font-mono">
      <button
        type="button"
        id="tab-selected"
        class="tab-btn px-3 py-1 rounded-md transition-all font-semibold bg-white dark:bg-slate-900 text-indigo-600 dark:text-indigo-400 shadow-2xs"
        data-filter="selected"
      >
        Selected ({selectedCount})
      </button>
      <button
        type="button"
        id="tab-all"
        class="tab-btn px-3 py-1 rounded-md transition-all text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200"
        data-filter="all"
      >
        All ({totalCount})
      </button>
    </div>
  </div>

  <!-- Publications List Grouped by Year -->
  <div id="publications-container" class="space-y-8">
    {
      years.map((year) => {
        const yearPubs = publications.filter((p) => p.year === year);
        const hasSelectedPubs = yearPubs.some((p) => p.selected);
        return (
          <div
            class="year-group space-y-3"
            data-year={year}
            style={hasSelectedPubs ? '' : 'display: none;'}
          >
            <!-- Year Header Marker -->
            <div class="flex items-center gap-3">
              <span class="font-mono text-sm font-bold text-slate-900 dark:text-slate-100 px-2.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/70">
                {year}
              </span>
              <div class="h-px flex-1 bg-slate-200 dark:bg-slate-800"></div>
            </div>

            <!-- Paper Cards for this Year -->
            <div class="space-y-3">
              {yearPubs.map((pub) => {
                const isAwardWinner = !!pub.award;
                return (
                  <article
                    class={`pub-item relative p-3.5 sm:p-4 rounded-xl border transition-all ${
                      isAwardWinner
                        ? 'bg-gradient-to-br from-amber-50/70 via-white to-amber-50/30 dark:from-amber-950/25 dark:via-slate-900/85 dark:to-slate-900 border-amber-300/90 dark:border-amber-700/80 shadow-xs ring-1 ring-amber-400/20'
                        : 'bg-white dark:bg-slate-900/60 border-slate-200/90 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700 shadow-2xs'
                    }`}
                    data-selected={pub.selected ? 'true' : 'false'}
                    data-id={pub.id}
                    style={pub.selected ? '' : 'display: none;'}
                  >
                    <div class="space-y-2">
                      <!-- Title and Badges Row -->
                      <div class="space-y-1">
                        <div class="flex flex-wrap items-baseline gap-2">
                          <h3 class="text-sm sm:text-base font-bold tracking-tight text-slate-900 dark:text-slate-100 leading-snug">
                            {pub.links.pdf ? (
                              <a
                                href={pub.links.pdf}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
                              >
                                {pub.title}
                              </a>
                            ) : pub.links.venue ? (
                              <a
                                href={pub.links.venue}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
                              >
                                {pub.title}
                              </a>
                            ) : pub.links.eprint ? (
                              <a
                                href={pub.links.eprint}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
                              >
                                {pub.title}
                              </a>
                            ) : pub.links.link ? (
                              <a
                                href={pub.links.link}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
                              >
                                {pub.title}
                              </a>
                            ) : (
                              <span>{pub.title}</span>
                            )}
                          </h3>

                          {pub.selected && (
                            <span class="inline-flex items-center px-1.5 py-0.2 rounded text-[10px] font-mono font-medium bg-indigo-50 text-indigo-700 dark:bg-indigo-950/60 dark:text-indigo-300 border border-indigo-200/70 dark:border-indigo-800/70 leading-none">
                              ★ Selected
                            </span>
                          )}
                        </div>

                        <!-- Authors List (Jipeng Zhang bolded, collaborators linked) -->
                        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                          {pub.authors.map((author, index) => {
                            const trimmed = author.trim();
                            const isMe =
                              trimmed.includes('Jipeng Zhang') ||
                              trimmed.includes('张吉鹏') ||
                              trimmed === 'Zhang, Jipeng';
                            const link = coauthorLinks[trimmed];
                            return (
                              <span>
                                {isMe ? (
                                  <strong class="font-bold text-slate-900 dark:text-slate-100 underline decoration-indigo-400 underline-offset-2">
                                    {trimmed}
                                  </strong>
                                ) : link ? (
                                  <a
                                    href={link}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-slate-700 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 hover:underline underline-offset-2 transition-colors"
                                  >
                                    {trimmed}
                                  </a>
                                ) : (
                                  <span>{trimmed}</span>
                                )}
                                {index < pub.authors.length - 1 && ', '}
                              </span>
                            );
                          })}
                        </p>
                      </div>

                      <!-- Venue Row & Distinguished Award Highlight -->
                      <div class="flex flex-wrap items-center gap-2 pt-0.5">
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono font-semibold bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700/80">
                          {pub.venueShort}
                        </span>

                        <span class="text-xs text-slate-500 dark:text-slate-400 hidden sm:inline">
                          {pub.venue}
                        </span>
                      </div>

                      <!-- USENIX Security 2024 Distinguished Paper Award Highlight Banner -->
                      {pub.award && (
                        <div class="p-2 sm:p-2.5 rounded-lg bg-gradient-to-r from-amber-100/90 via-amber-50 to-amber-100/60 dark:from-amber-950/50 dark:via-amber-900/30 dark:to-amber-950/40 border border-amber-300 dark:border-amber-700/80 text-amber-900 dark:text-amber-200 text-xs flex flex-wrap items-center gap-2 shadow-2xs">
                          <span class="font-bold flex items-center gap-1.5">
                            <svg width="16" height="16" class="w-4 h-4 text-amber-600 dark:text-amber-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                            </svg>
                            🏆 {pub.award}
                          </span>
                          {pub.links.awardLink && (
                            <a
                              href={pub.links.awardLink}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="underline font-medium hover:text-amber-950 dark:hover:text-amber-100 text-[11px] ml-auto"
                            >
                              Presentation Session →
                            </a>
                          )}
                        </div>
                      )}

                      <!-- Artifact Evaluation Badges Row -->
                      {pub.artifactBadges && pub.artifactBadges.length > 0 && (
                        <div class="flex flex-wrap items-center gap-1.5 pt-1">
                          <span class="text-[11px] font-mono text-slate-500 dark:text-slate-400 mr-0.5">
                            Artifacts:
                          </span>
                          {pub.artifactBadges.map((badge) => (
                            <ArtifactBadge
                              type={badge.type}
                              label={badge.label}
                              url={badge.url}
                            />
                          ))}
                        </div>
                      )}

                      <!-- Action Links & BibTeX Button -->
                      <div class="flex flex-wrap items-center gap-1.5 pt-1.5">
                        {pub.links.pdf && (
                          <a
                            href={pub.links.pdf}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="action-link inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-mono font-medium bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:text-indigo-600 dark:hover:text-indigo-400 hover:border-indigo-400 transition-colors"
                          >
                            <span>[PDF]</span>
                          </a>
                        )}

                        {pub.links.eprint && (
                          <a
                            href={pub.links.eprint}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="action-link inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-mono font-medium bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:text-indigo-600 dark:hover:text-indigo-400 hover:border-indigo-400 transition-colors"
                          >
                            <span>[ePrint]</span>
                          </a>
                        )}

                        {pub.links.code && (
                          <a
                            href={pub.links.code}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="action-link inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-mono font-medium bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:text-indigo-600 dark:hover:text-indigo-400 hover:border-indigo-400 transition-colors"
                          >
                            <span>[Code]</span>
                          </a>
                        )}

                        {pub.links.codeAvx2 && (
                          <a
                            href={pub.links.codeAvx2}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="action-link inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-mono font-medium bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:text-indigo-600 dark:hover:text-indigo-400 hover:border-indigo-400 transition-colors"
                          >
                            <span>[Code.AVX2]</span>
                          </a>
                        )}

                        {pub.links.codeAvx512 && (
                          <a
                            href={pub.links.codeAvx512}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="action-link inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-mono font-medium bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:text-indigo-600 dark:hover:text-indigo-400 hover:border-indigo-400 transition-colors"
                          >
                            <span>[Code.AVX-512]</span>
                          </a>
                        )}

                        {pub.links.zenodo && (
                          <a
                            href={pub.links.zenodo}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="action-link inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-mono font-medium bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:text-indigo-600 dark:hover:text-indigo-400 hover:border-indigo-400 transition-colors"
                          >
                            <span>[Zenodo]</span>
                          </a>
                        )}

                        {pub.links.slides && (
                          <a
                            href={pub.links.slides}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="action-link inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-mono font-medium bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:text-indigo-600 dark:hover:text-indigo-400 hover:border-indigo-400 transition-colors"
                          >
                            <span>[Slide]</span>
                          </a>
                        )}

                        {pub.links.video && (
                          <a
                            href={pub.links.video}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="action-link inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-mono font-medium bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:text-indigo-600 dark:hover:text-indigo-400 hover:border-indigo-400 transition-colors"
                          >
                            <span>[Video]</span>
                          </a>
                        )}

                        {pub.links.award && (
                          <a
                            href={pub.links.award}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="action-link inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-mono font-medium bg-amber-50 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 border border-amber-300 dark:border-amber-700/80 hover:bg-amber-100 transition-colors"
                          >
                            <span>[Award PDF]</span>
                          </a>
                        )}

                        {pub.links.venue && (
                          <a
                            href={pub.links.venue}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="action-link inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-mono font-medium bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:text-indigo-600 dark:hover:text-indigo-400 hover:border-indigo-400 transition-colors"
                          >
                            <span>[Official]</span>
                          </a>
                        )}

                        {pub.links.link && !pub.links.pdf && !pub.links.eprint && (
                          <a
                            href={pub.links.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="action-link inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-mono font-medium bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:text-indigo-600 dark:hover:text-indigo-400 hover:border-indigo-400 transition-colors"
                          >
                            <span>[DOI]</span>
                          </a>
                        )}

                        <!-- BibTeX Toggle Button -->
                        <button
                          type="button"
                          class="bibtex-toggle-btn inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-mono font-medium bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:text-indigo-600 dark:hover:text-indigo-400 hover:border-indigo-400 transition-colors cursor-pointer"
                          data-target={`bibtex-${pub.id}`}
                          aria-expanded="false"
                        >
                          <svg width="12" height="12" class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                          </svg>
                          <span>[BibTeX]</span>
                        </button>
                      </div>

                      <!-- Expandable BibTeX Snippet Box -->
                      <div
                        id={`bibtex-${pub.id}`}
                        class="bibtex-panel hidden pt-2 transition-all"
                      >
                        <div class="relative rounded-lg bg-slate-100 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800 p-3 text-xs font-mono text-slate-800 dark:text-slate-200">
                          <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-200 dark:border-slate-800">
                            <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                              BibTeX Citation
                            </span>
                            <button
                              type="button"
                              class="copy-bibtex-btn inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-mono bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 transition-all cursor-pointer"
                              data-bibtex={pub.bibtex}
                            >
                              <svg width="12" height="12" class="w-3 h-3 copy-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
                              </svg>
                              <span class="copy-text">Copy</span>
                            </button>
                          </div>
                          <pre class="overflow-x-auto text-[11px] leading-relaxed whitespace-pre font-mono select-all text-slate-700 dark:text-slate-300"><code>{pub.bibtex}</code></pre>
                        </div>
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<script is:inline>
  (function () {
    if (window.__publicationsInteractivityInitialized) return;
    window.__publicationsInteractivityInitialized = true;

    function applyFilter(filter) {
      var tabAll = document.getElementById('tab-all');
      var tabSelected = document.getElementById('tab-selected');
      var pubItems = document.querySelectorAll('.pub-item');
      var yearGroups = document.querySelectorAll('.year-group');

      if (filter === 'all') {
        if (tabAll) {
          tabAll.classList.add('bg-white', 'dark:bg-slate-900', 'text-indigo-600', 'dark:text-indigo-400', 'font-semibold', 'shadow-2xs');
          tabAll.classList.remove('text-slate-600', 'dark:text-slate-400');
        }
        if (tabSelected) {
          tabSelected.classList.remove('bg-white', 'dark:bg-slate-900', 'text-indigo-600', 'dark:text-indigo-400', 'font-semibold', 'shadow-2xs');
          tabSelected.classList.add('text-slate-600', 'dark:text-slate-400');
        }

        pubItems.forEach(function (el) {
          el.style.display = '';
        });
        yearGroups.forEach(function (group) {
          group.style.display = '';
        });
      } else {
        if (tabSelected) {
          tabSelected.classList.add('bg-white', 'dark:bg-slate-900', 'text-indigo-600', 'dark:text-indigo-400', 'font-semibold', 'shadow-2xs');
          tabSelected.classList.remove('text-slate-600', 'dark:text-slate-400');
        }
        if (tabAll) {
          tabAll.classList.remove('bg-white', 'dark:bg-slate-900', 'text-indigo-600', 'dark:text-indigo-400', 'font-semibold', 'shadow-2xs');
          tabAll.classList.add('text-slate-600', 'dark:text-slate-400');
        }

        pubItems.forEach(function (el) {
          var isSelected = el.getAttribute('data-selected') === 'true';
          el.style.display = isSelected ? '' : 'none';
        });

        // Hide year headers that have no visible papers
        yearGroups.forEach(function (group) {
          var visibleChildren = group.querySelectorAll('.pub-item:not([style*="display: none"])');
          group.style.display = visibleChildren.length > 0 ? '' : 'none';
        });
      }
    }

    function showCopiedUI(btn) {
      var textSpan = btn.querySelector('.copy-text');
      if (textSpan) {
        var originalText = textSpan.textContent;
        textSpan.textContent = 'Copied!';
        btn.classList.add('text-emerald-600', 'dark:text-emerald-400', 'border-emerald-400');
        setTimeout(function () {
          textSpan.textContent = originalText;
          btn.classList.remove('text-emerald-600', 'dark:text-emerald-400', 'border-emerald-400');
        }, 2000);
      }
    }

    function fallbackCopy(btn, text) {
      try {
        var textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.left = '-9999px';
        textarea.style.top = '-9999px';
        textarea.style.fontSize = '16px'; // Prevents auto-zoom on iOS Safari
        document.body.appendChild(textarea);
        textarea.focus();
        textarea.select();
        textarea.setSelectionRange(0, textarea.value.length); // Required for iOS Safari
        var success = document.execCommand('copy');
        document.body.removeChild(textarea);
        if (success) {
          showCopiedUI(btn);
        }
      } catch (err) {
        console.error('Copy fallback failed:', err);
      }
    }

    // Unified delegated click listener (immune to duplicate bindings)
    document.addEventListener('click', function (e) {
      var target = e.target;
      if (!target || !target.closest) return;

      // 1. Tab buttons
      var tabBtn = target.closest('.tab-btn');
      if (tabBtn) {
        var filter = tabBtn.getAttribute('data-filter');
        if (filter) applyFilter(filter);
        return;
      }

      // 2. BibTeX toggle button
      var bibtexBtn = target.closest('.bibtex-toggle-btn');
      if (bibtexBtn) {
        var targetId = bibtexBtn.getAttribute('data-target');
        if (!targetId) return;
        var panel = document.getElementById(targetId);
        if (!panel) return;

        var isHidden = panel.classList.contains('hidden');
        if (isHidden) {
          panel.classList.remove('hidden');
          bibtexBtn.setAttribute('aria-expanded', 'true');
          bibtexBtn.classList.add('text-indigo-600', 'dark:text-indigo-400', 'border-indigo-400');
        } else {
          panel.classList.add('hidden');
          bibtexBtn.setAttribute('aria-expanded', 'false');
          bibtexBtn.classList.remove('text-indigo-600', 'dark:text-indigo-400', 'border-indigo-400');
        }
        return;
      }

      // 3. Copy BibTeX button
      var copyBtn = target.closest('.copy-bibtex-btn');
      if (copyBtn) {
        var bibtex = copyBtn.getAttribute('data-bibtex');
        if (!bibtex) return;

        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(bibtex).then(function () {
            showCopiedUI(copyBtn);
          }).catch(function () {
            fallbackCopy(copyBtn, bibtex);
          });
        } else {
          fallbackCopy(copyBtn, bibtex);
        }
        return;
      }
    });
  })();
</script>
