---
import publications, { selectedPublications } from '../data/publications';
import PublicationCard from './PublicationCard.astro';

// Group all publications by year descending for the 'All' tab
const years = Array.from(new Set(publications.map((p) => p.year))).sort((a, b) => b - a);

// Curate selected publications so USENIX Security 2024 Distinguished Paper Award is permanently at #1
const curatedSelected = [...selectedPublications].sort((a, b) => {
  if (a.id === 'sec2024-eng25519') return -1;
  if (b.id === 'sec2024-eng25519') return 1;
  return b.year - a.year;
});

const totalCount = publications.length;
const selectedCount = curatedSelected.length;
---

<section id="publications" class="glass glass-glow scroll-mt-20 rounded-2xl p-4 sm:p-5 space-y-4">
  <!-- Section Header & Filter Tabs -->
  <div class="space-y-3">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="space-y-0.5">
        <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-slate-100 flex items-center gap-2">
          <span class="glass-pill glass-tint-indigo p-0 w-7 h-7 justify-center flex-shrink-0" aria-hidden="true">
            <svg width="16" height="16" class="w-4 h-4 text-indigo-600 dark:text-indigo-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
            </svg>
          </span>
          Publications
        </h2>
        <p class="text-xs text-slate-600 dark:text-slate-400">
          Top-tier security & architecture venues (USENIX Security, MICRO, ACM CCS, CHES/TCHES, ASIACRYPT)
        </p>
      </div>

      <!-- Filter Buttons (iOS-style segmented control with a sliding glass thumb) -->
      <div class="pub-segment glass-segment glass-refract relative self-start sm:self-auto text-xs font-mono" role="tablist" aria-label="Publication filter">
        <span class="pub-seg-thumb" aria-hidden="true"></span>
        <button
          type="button"
          id="tab-selected"
          class="tab-btn glass-segment-item is-active relative z-[1] cursor-pointer"
          role="tab"
          aria-selected="true"
          aria-controls="selected-publications-container"
          data-filter="selected"
        >
          Selected ({selectedCount})
        </button>
        <button
          type="button"
          id="tab-all"
          class="tab-btn glass-segment-item relative z-[1] cursor-pointer"
          role="tab"
          aria-selected="false"
          aria-controls="all-publications-container"
          data-filter="all"
        >
          All ({totalCount})
        </button>
      </div>
    </div>
    <div class="glass-divider"></div>
  </div>

  <!-- 1. Selected Publications View (Default active view, USENIX Distinguished Paper #1) -->
  <div id="selected-publications-container" class="space-y-3">
    {curatedSelected.map((pub) => (
      <PublicationCard pub={pub} prefix="selected" />
    ))}
  </div>

  <!-- 2. All Publications View (Grouped chronologically by Year) -->
  <div id="all-publications-container" class="space-y-6" style="display: none;">
    {
      years.map((year) => {
        const yearPubs = publications.filter((p) => p.year === year);
        return (
          <div class="year-group space-y-3" data-year={year}>
            <!-- Year Header Marker -->
            <div class="flex items-center gap-3">
              <span class="glass-pill font-mono text-sm font-bold text-slate-900 dark:text-slate-100 px-2.5 py-0.5">
                {year}
              </span>
              <div class="glass-divider flex-1"></div>
            </div>

            <!-- Paper Cards for this Year -->
            <div class="space-y-3">
              {yearPubs.map((pub) => (
                <PublicationCard pub={pub} prefix="all" />
              ))}
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<script is:inline>
  (function () {
    if (window.__publicationsInteractivityInitialized) return;
    window.__publicationsInteractivityInitialized = true;

    function positionThumb() {
      var segment = document.querySelector('.pub-segment');
      if (!segment) return;
      var thumb = segment.querySelector('.pub-seg-thumb');
      var active = segment.querySelector('.tab-btn.is-active');
      if (!thumb || !active || !active.offsetWidth) return;
      thumb.style.width = active.offsetWidth + 'px';
      thumb.style.transform = 'translateX(' + active.offsetLeft + 'px)';
      if (!segment.classList.contains('has-thumb')) {
        segment.classList.add('has-thumb');
        // Enable the slide transition only after the first placement
        requestAnimationFrame(function () {
          requestAnimationFrame(function () { segment.classList.add('thumb-ready'); });
        });
      }
    }

    function setTabState(tab, active) {
      if (!tab) return;
      tab.classList.toggle('is-active', active);
      tab.setAttribute('aria-selected', active ? 'true' : 'false');
    }

    function applyFilter(filter) {
      var tabAll = document.getElementById('tab-all');
      var tabSelected = document.getElementById('tab-selected');
      var selectedContainer = document.getElementById('selected-publications-container');
      var allContainer = document.getElementById('all-publications-container');
      var showAll = filter === 'all';

      setTabState(tabAll, showAll);
      setTabState(tabSelected, !showAll);

      if (selectedContainer) selectedContainer.style.display = showAll ? 'none' : '';
      if (allContainer) allContainer.style.display = showAll ? '' : 'none';

      positionThumb();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', positionThumb);
    } else {
      positionThumb();
    }
    window.addEventListener('load', positionThumb);
    window.addEventListener('resize', positionThumb);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(positionThumb);

    function showCopiedUI(btn) {
      var textSpan = btn.querySelector('.copy-text');
      if (textSpan) {
        var originalText = textSpan.textContent;
        textSpan.textContent = 'Copied!';
        btn.classList.add('text-indigo-600', 'dark:text-indigo-400', 'border-indigo-400');
        setTimeout(function () {
          textSpan.textContent = originalText;
          btn.classList.remove('text-indigo-600', 'dark:text-indigo-400', 'border-indigo-400');
        }, 2000);
      }
    }

    function fallbackCopy(btn, text) {
      try {
        var textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.left = '-9999px';
        textarea.style.top = '-9999px';
        textarea.style.fontSize = '16px';
        document.body.appendChild(textarea);
        textarea.focus();
        textarea.select();
        textarea.setSelectionRange(0, textarea.value.length);
        var success = document.execCommand('copy');
        document.body.removeChild(textarea);
        if (success) {
          showCopiedUI(btn);
        }
      } catch (err) {
        console.error('Copy fallback failed:', err);
      }
    }

    // Unified delegated click listener (immune to duplicate bindings)
    document.addEventListener('click', function (e) {
      var target = e.target;
      if (!target || !target.closest) return;

      // 1. Tab buttons
      var tabBtn = target.closest('.tab-btn');
      if (tabBtn) {
        var filter = tabBtn.getAttribute('data-filter');
        if (filter) applyFilter(filter);
        return;
      }

      // 2. BibTeX toggle button
      var bibtexBtn = target.closest('.bibtex-toggle-btn');
      if (bibtexBtn) {
        var targetId = bibtexBtn.getAttribute('data-target');
        if (!targetId) return;
        var panel = document.getElementById(targetId);
        if (!panel) return;

        var isHidden = panel.classList.contains('hidden');
        if (isHidden) {
          panel.classList.remove('hidden');
          bibtexBtn.setAttribute('aria-expanded', 'true');
          bibtexBtn.classList.add('text-indigo-600', 'dark:text-indigo-400', 'border-indigo-400');
        } else {
          panel.classList.add('hidden');
          bibtexBtn.setAttribute('aria-expanded', 'false');
          bibtexBtn.classList.remove('text-indigo-600', 'dark:text-indigo-400', 'border-indigo-400');
        }
        return;
      }

      // 3. Copy BibTeX button
      var copyBtn = target.closest('.copy-bibtex-btn');
      if (copyBtn) {
        var bibtex = copyBtn.getAttribute('data-bibtex');
        if (!bibtex) return;

        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(bibtex).then(function () {
            showCopiedUI(copyBtn);
          }).catch(function () {
            fallbackCopy(copyBtn, bibtex);
          });
        } else {
          fallbackCopy(copyBtn, bibtex);
        }
        return;
      }
    });
  })();
</script>

<style>
  /* Sliding glass thumb for the segmented control. Without JS the
     .is-active item keeps its own glass fill from global.css. */
  .pub-seg-thumb {
    position: absolute;
    top: 0.1875rem;
    bottom: 0.1875rem;
    left: 0;
    width: 0;
    border-radius: 9999px;
    background: var(--glass-chip-bg-hover);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.95), 0 1px 3px rgba(15, 23, 42, 0.12), 0 0 0 1px rgba(15, 23, 42, 0.05);
    opacity: 0;
    pointer-events: none;
  }

  :global(html.dark) .pub-seg-thumb {
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14), 0 1px 4px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .pub-segment.has-thumb .pub-seg-thumb {
    opacity: 1;
  }

  .pub-segment.thumb-ready .pub-seg-thumb {
    transition: transform 0.35s var(--glass-spring), width 0.35s var(--glass-spring);
  }

  .pub-segment.has-thumb .tab-btn.is-active {
    background: transparent;
    box-shadow: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .pub-segment.thumb-ready .pub-seg-thumb {
      transition: none;
    }
  }

  @media print {
    .pub-seg-thumb {
      display: none !important;
    }
  }
</style>
