---
import type { Publication } from '../data/types';
import { coauthorLinks } from '../data/coauthors';
import ArtifactBadge from './ArtifactBadge.astro';

interface Props {
  pub: Publication;
  prefix?: string;
}

const { pub, prefix = 'pub' } = Astro.props;
const isAwardWinner = !!pub.award;
const panelId = `bibtex-${prefix}-${pub.id}`;
const titleHref = pub.links.pdf || pub.links.venue || pub.links.eprint || pub.links.link;
const showSelectedBadge = pub.selected && prefix !== 'selected';

const actionLinks: { label: string; url?: string; award?: boolean }[] = [
  { label: 'PDF', url: pub.links.pdf },
  { label: 'ePrint', url: pub.links.eprint },
  { label: 'Code', url: pub.links.code },
  { label: 'Code (AVX2)', url: pub.links.codeAvx2 },
  { label: 'Code (AVX-512)', url: pub.links.codeAvx512 },
  { label: 'Zenodo', url: pub.links.zenodo },
  { label: 'Slides', url: pub.links.slides },
  { label: 'Video', url: pub.links.video },
  { label: 'Award PDF', url: pub.links.award, award: true },
  { label: 'Official', url: pub.links.venue },
  { label: 'DOI', url: !pub.links.pdf && !pub.links.eprint ? pub.links.link : undefined },
];
---

<article
  class={`pub-item glass-subtle glass-subtle-hover relative p-3 sm:p-3.5 rounded-xl ${isAwardWinner ? 'pub-award' : ''}`}
  data-selected={pub.selected ? 'true' : 'false'}
  data-id={pub.id}
>
  <div class="space-y-2">
    <!-- Title and Badges Row -->
    <div class="space-y-1">
      <div class="flex flex-wrap items-baseline gap-2">
        <h3 class="text-sm sm:text-base font-bold tracking-tight text-slate-900 dark:text-slate-100 leading-snug">
          {titleHref ? (
            <a
              href={titleHref}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
            >{pub.title}</a>
          ) : (
            <span>{pub.title}</span>
          )}
        </h3>

        {showSelectedBadge && (
          <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-mono font-medium bg-indigo-500/10 text-indigo-700 dark:bg-indigo-400/15 dark:text-indigo-200 border border-indigo-500/25 dark:border-indigo-400/30 leading-none">
            ★ Selected
          </span>
        )}
      </div>

      <!-- Authors List (Jipeng Zhang bolded, collaborators linked) -->
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
        {pub.authors.map((author, index) => {
          const trimmed = author.trim();
          const isMe =
            trimmed.includes('Jipeng Zhang') ||
            trimmed.includes('张吉鹏') ||
            trimmed === 'Zhang, Jipeng';
          const link = coauthorLinks[trimmed];
          const sep = index < pub.authors.length - 1 ? ', ' : '';
          return isMe ? (
            <Fragment><strong class="font-bold text-slate-900 dark:text-slate-100 underline decoration-indigo-400 underline-offset-2">{trimmed}</strong>{sep}</Fragment>
          ) : link ? (
            <Fragment><a href={link} target="_blank" rel="noopener noreferrer" class="text-slate-700 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 hover:underline underline-offset-2 transition-colors">{trimmed}</a>{sep}</Fragment>
          ) : (
            <Fragment>{trimmed}{sep}</Fragment>
          );
        })}
      </p>
    </div>

    <!-- Venue Row & Short Acronym Tag -->
    <div class="flex flex-wrap items-center gap-2 pt-0.5">
      <span class="glass-pill glass-tint-indigo px-2 py-0.5 text-[11px] font-mono font-semibold">
        {pub.venueShort}
      </span>

      <span class="text-xs text-slate-600 dark:text-slate-400 hidden sm:inline">
        {pub.venue}
      </span>
    </div>

    <!-- USENIX Security 2024 Distinguished Paper Award Highlight Banner -->
    {pub.award && (
      <div class="pub-award-banner p-2 sm:p-2.5 rounded-lg border text-amber-900 dark:text-amber-200 text-xs flex flex-wrap items-center gap-2">
        <span class="font-bold flex items-center gap-1.5">
          <svg width="16" height="16" class="w-4 h-4 text-amber-600 dark:text-amber-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          🏆 {pub.award}
        </span>
        <div class="flex items-center gap-2 ml-auto text-[11px]">
          {pub.links.statsLink && (
            <a
              href={pub.links.statsLink}
              target="_blank"
              rel="noopener noreferrer"
              class="underline font-medium hover:text-amber-950 dark:hover:text-amber-100"
            >
              Stats
            </a>
          )}
          {pub.links.awardLink && (
            <a
              href={pub.links.awardLink}
              target="_blank"
              rel="noopener noreferrer"
              class="underline font-medium hover:text-amber-950 dark:hover:text-amber-100"
            >
              Presentation Session →
            </a>
          )}
        </div>
      </div>
    )}

    <!-- Artifact Evaluation Badges Row -->
    {pub.artifactBadges && pub.artifactBadges.length > 0 && (
      <div class="flex flex-wrap items-center gap-1.5 pt-1">
        <span class="text-[11px] font-mono text-slate-600 dark:text-slate-400 mr-0.5">
          Artifacts:
        </span>
        {pub.artifactBadges.map((badge) => (
          <ArtifactBadge
            type={badge.type}
            label={badge.label}
            url={badge.url}
          />
        ))}
      </div>
    )}

    <!-- Action Links & BibTeX Button -->
    <div class="flex flex-wrap items-center gap-1.5 pt-1.5">
      {actionLinks.filter((l) => l.url).map((l) => (
        <a href={l.url} target="_blank" rel="noopener noreferrer" class={l.award ? 'link-btn link-btn-award' : 'link-btn'}>{l.label}</a>
      ))}

      <!-- BibTeX Toggle Button -->
      <button
        type="button"
        class="bibtex-toggle-btn link-btn cursor-pointer"
        data-target={panelId}
        aria-expanded="false"
      >
        <svg width="12" height="12" class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
        </svg>
        <span>BibTeX</span>
      </button>
    </div>

    <!-- Expandable BibTeX Snippet Box -->
    <div
      id={panelId}
      class="bibtex-panel hidden pt-2 transition-all"
    >
      <div class="bibtex-frost relative rounded-lg border p-3 text-xs font-mono text-slate-800 dark:text-slate-200">
        <div class="flex items-center justify-between pb-2">
          <span class="text-[11px] font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider">
            BibTeX Citation
          </span>
          <button
            type="button"
            class="copy-bibtex-btn link-btn text-[11px] cursor-pointer"
            data-bibtex={pub.bibtex}
          >
            <svg width="12" height="12" class="w-3 h-3 copy-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
            </svg>
            <span class="copy-text">Copy</span>
          </button>
        </div>
        <div class="glass-divider mb-2"></div>
        <pre class="overflow-x-auto text-[11px] leading-relaxed whitespace-pre font-mono select-all text-slate-700 dark:text-slate-300"><code>{pub.bibtex}</code></pre>
      </div>
    </div>
  </div>
</article>

<style>
  /* Warm glass for award-winning papers (no backdrop-filter: cheap per row) */
  .pub-award {
    background: linear-gradient(135deg, rgba(254, 243, 199, 0.62), rgba(255, 255, 255, 0.5) 45%, rgba(254, 243, 199, 0.4));
    border-color: rgba(217, 119, 6, 0.35);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.75), 0 0 0 1px rgba(251, 191, 36, 0.12), 0 6px 18px -8px rgba(217, 119, 6, 0.35);
  }

  .pub-award:hover {
    background: linear-gradient(135deg, rgba(254, 243, 199, 0.78), rgba(255, 255, 255, 0.7) 45%, rgba(254, 243, 199, 0.55));
    border-color: rgba(217, 119, 6, 0.5);
  }

  :global(html.dark) .pub-award {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.14), rgba(255, 255, 255, 0.03) 45%, rgba(245, 158, 11, 0.06));
    border-color: rgba(251, 191, 36, 0.3);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07), 0 0 0 1px rgba(251, 191, 36, 0.06), 0 8px 22px -10px rgba(245, 158, 11, 0.35);
  }

  :global(html.dark) .pub-award:hover {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.2), rgba(255, 255, 255, 0.05) 45%, rgba(245, 158, 11, 0.09));
    border-color: rgba(251, 191, 36, 0.45);
  }

  .pub-award-banner {
    background: linear-gradient(90deg, rgba(253, 230, 138, 0.55), rgba(255, 251, 235, 0.55) 50%, rgba(253, 230, 138, 0.35));
    border-color: rgba(217, 119, 6, 0.32);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  :global(html.dark) .pub-award-banner {
    background: linear-gradient(90deg, rgba(245, 158, 11, 0.2), rgba(245, 158, 11, 0.08) 50%, rgba(245, 158, 11, 0.14));
    border-color: rgba(251, 191, 36, 0.3);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  /* Frosted BibTeX panel: translucent fill only (it sits inside the section's blur) */
  .bibtex-frost {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.7), rgba(248, 250, 252, 0.55));
    border-color: rgba(15, 23, 42, 0.09);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9), inset 0 1px 6px rgba(15, 23, 42, 0.04);
  }

  :global(html.dark) .bibtex-frost {
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.2));
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05), inset 0 1px 6px rgba(0, 0, 0, 0.3);
  }

  @media (prefers-reduced-transparency: reduce) {
    .pub-award {
      background: #fffbeb;
    }

    :global(html.dark) .pub-award {
      background: #241c10;
    }

    .bibtex-frost {
      background: #f8fafc;
    }

    :global(html.dark) .bibtex-frost {
      background: #0f121b;
    }
  }

  @media print {
    .pub-award,
    .pub-award-banner,
    .bibtex-frost {
      background: none !important;
      box-shadow: none !important;
    }

    .pub-award-banner {
      border-color: #cbd5e1 !important;
      color: #000000 !important;
    }
  }
</style>
