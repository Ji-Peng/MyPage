---
import type { ArtifactBadgeType } from '../data/types';

interface Props {
  type: ArtifactBadgeType | string;
  label?: string;
  url?: string;
}

const { type, label, url } = Astro.props;

const configMap: Record<string, { defaultLabel: string; tintClass: string; icon: string }> = {
  available: { defaultLabel: 'Artifacts Available', tintClass: 'ab-emerald', icon: 'box' },
  functional: { defaultLabel: 'Artifacts Functional', tintClass: 'ab-sky', icon: 'check' },
  reproduced: { defaultLabel: 'Results Reproduced', tintClass: 'ab-violet', icon: 'refresh' },
  evaluated: { defaultLabel: 'Artifact Evaluated', tintClass: 'ab-amber', icon: 'award' },
};

const badgeConfig = configMap[type] || configMap.available;
const displayLabel = label || badgeConfig.defaultLabel;
const baseClasses = `glass-pill ${badgeConfig.tintClass} gap-1 px-2 py-0.5 text-[11px] leading-none`;
---

{
  url ? (
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class={`${baseClasses} group focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500/60`}
      title={`${displayLabel} (opens in new tab)`}
    >
      {badgeConfig.icon === 'box' && (
        <svg width="12" height="12" class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
        </svg>
      )}
      {badgeConfig.icon === 'check' && (
        <svg width="12" height="12" class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
      )}
      {badgeConfig.icon === 'refresh' && (
        <svg width="12" height="12" class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
        </svg>
      )}
      {badgeConfig.icon === 'award' && (
        <svg width="12" height="12" class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
        </svg>
      )}
      <span>{displayLabel}</span>
      <svg width="10" height="10" class="w-2.5 h-2.5 opacity-60 group-hover:opacity-100 transition-opacity flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
      </svg>
    </a>
  ) : (
    <span class={baseClasses}>
      {badgeConfig.icon === 'box' && (
        <svg width="12" height="12" class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
        </svg>
      )}
      {badgeConfig.icon === 'check' && (
        <svg width="12" height="12" class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
      )}
      {badgeConfig.icon === 'refresh' && (
        <svg width="12" height="12" class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
        </svg>
      )}
      {badgeConfig.icon === 'award' && (
        <svg width="12" height="12" class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
        </svg>
      )}
      <span>{displayLabel}</span>
    </span>
  )
}

<style>
  /* Per-badge tints: rebind the shared glass chip tokens (see global.css) */
  .ab-emerald {
    --glass-chip-bg: linear-gradient(180deg, rgba(236, 253, 245, 0.95), rgba(209, 250, 229, 0.65));
    --glass-chip-bg-hover: linear-gradient(180deg, #ecfdf5, rgba(167, 243, 208, 0.75));
    --glass-chip-border: rgba(5, 150, 105, 0.3);
    --glass-chip-border-hover: rgba(5, 150, 105, 0.55);
    --glass-chip-text: #047857;
    --glass-chip-text-hover: #065f46;
    --glass-chip-shadow-hover: inset 0 1px 0 #ffffff, 0 4px 10px -3px rgba(5, 150, 105, 0.3);
  }

  .ab-sky {
    --glass-chip-bg: linear-gradient(180deg, rgba(240, 249, 255, 0.95), rgba(224, 242, 254, 0.65));
    --glass-chip-bg-hover: linear-gradient(180deg, #f0f9ff, rgba(186, 230, 253, 0.75));
    --glass-chip-border: rgba(2, 132, 199, 0.3);
    --glass-chip-border-hover: rgba(2, 132, 199, 0.55);
    --glass-chip-text: #0369a1;
    --glass-chip-text-hover: #075985;
    --glass-chip-shadow-hover: inset 0 1px 0 #ffffff, 0 4px 10px -3px rgba(2, 132, 199, 0.3);
  }

  .ab-violet {
    --glass-chip-bg: linear-gradient(180deg, rgba(245, 243, 255, 0.95), rgba(237, 233, 254, 0.65));
    --glass-chip-bg-hover: linear-gradient(180deg, #f5f3ff, rgba(221, 214, 254, 0.75));
    --glass-chip-border: rgba(124, 58, 237, 0.28);
    --glass-chip-border-hover: rgba(124, 58, 237, 0.5);
    --glass-chip-text: #6d28d9;
    --glass-chip-text-hover: #5b21b6;
    --glass-chip-shadow-hover: inset 0 1px 0 #ffffff, 0 4px 10px -3px rgba(124, 58, 237, 0.3);
  }

  .ab-amber {
    --glass-chip-bg: linear-gradient(180deg, rgba(255, 251, 235, 0.95), rgba(254, 243, 199, 0.7));
    --glass-chip-bg-hover: linear-gradient(180deg, #fffbeb, rgba(253, 230, 138, 0.8));
    --glass-chip-border: rgba(217, 119, 6, 0.35);
    --glass-chip-border-hover: rgba(217, 119, 6, 0.6);
    --glass-chip-text: #92400e;
    --glass-chip-text-hover: #78350f;
    --glass-chip-shadow-hover: inset 0 1px 0 #ffffff, 0 4px 10px -3px rgba(217, 119, 6, 0.3);
  }

  :global(html.dark) .ab-emerald {
    --glass-chip-bg: linear-gradient(180deg, rgba(16, 185, 129, 0.2), rgba(16, 185, 129, 0.07));
    --glass-chip-bg-hover: linear-gradient(180deg, rgba(16, 185, 129, 0.3), rgba(16, 185, 129, 0.12));
    --glass-chip-border: rgba(52, 211, 153, 0.32);
    --glass-chip-border-hover: rgba(52, 211, 153, 0.6);
    --glass-chip-text: #6ee7b7;
    --glass-chip-text-hover: #a7f3d0;
    --glass-chip-shadow-hover: inset 0 1px 0 rgba(255, 255, 255, 0.15), 0 4px 12px -3px rgba(16, 185, 129, 0.4);
  }

  :global(html.dark) .ab-sky {
    --glass-chip-bg: linear-gradient(180deg, rgba(14, 165, 233, 0.2), rgba(14, 165, 233, 0.07));
    --glass-chip-bg-hover: linear-gradient(180deg, rgba(14, 165, 233, 0.3), rgba(14, 165, 233, 0.12));
    --glass-chip-border: rgba(56, 189, 248, 0.32);
    --glass-chip-border-hover: rgba(56, 189, 248, 0.6);
    --glass-chip-text: #7dd3fc;
    --glass-chip-text-hover: #bae6fd;
    --glass-chip-shadow-hover: inset 0 1px 0 rgba(255, 255, 255, 0.15), 0 4px 12px -3px rgba(14, 165, 233, 0.4);
  }

  :global(html.dark) .ab-violet {
    --glass-chip-bg: linear-gradient(180deg, rgba(139, 92, 246, 0.22), rgba(139, 92, 246, 0.08));
    --glass-chip-bg-hover: linear-gradient(180deg, rgba(139, 92, 246, 0.32), rgba(139, 92, 246, 0.13));
    --glass-chip-border: rgba(167, 139, 250, 0.34);
    --glass-chip-border-hover: rgba(167, 139, 250, 0.6);
    --glass-chip-text: #c4b5fd;
    --glass-chip-text-hover: #ddd6fe;
    --glass-chip-shadow-hover: inset 0 1px 0 rgba(255, 255, 255, 0.15), 0 4px 12px -3px rgba(139, 92, 246, 0.4);
  }

  :global(html.dark) .ab-amber {
    --glass-chip-bg: linear-gradient(180deg, rgba(245, 158, 11, 0.2), rgba(245, 158, 11, 0.08));
    --glass-chip-bg-hover: linear-gradient(180deg, rgba(245, 158, 11, 0.28), rgba(245, 158, 11, 0.12));
    --glass-chip-border: rgba(251, 191, 36, 0.35);
    --glass-chip-border-hover: rgba(251, 191, 36, 0.6);
    --glass-chip-text: #fcd34d;
    --glass-chip-text-hover: #fde68a;
    --glass-chip-shadow-hover: inset 0 1px 0 rgba(255, 255, 255, 0.15), 0 4px 12px -3px rgba(245, 158, 11, 0.35);
  }
</style>
