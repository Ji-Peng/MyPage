---
import news from '../data/news';

// Guarantee pinned news items are permanently pinned at the top, with ENG25519 first
const sortedNews = [...news].sort((a, b) => {
  if (a.pinned && b.pinned) {
    if (a.id === 'news-eng25519-award') return -1;
    if (b.id === 'news-eng25519-award') return 1;
    return 0;
  }
  return (b.pinned ? 1 : 0) - (a.pinned ? 1 : 0);
});
---

<section id="news" class="scroll-mt-20 space-y-3">
  <div class="flex items-center justify-between pb-2 border-b border-slate-200 dark:border-slate-800">
    <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-slate-100 flex items-center gap-2">
      <svg width="20" height="20" class="w-5 h-5 text-indigo-600 dark:text-indigo-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 0 1-2.25 2.25M16.5 7.5V18a2.25 2.25 0 0 0 2.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 0 0 2.25 2.25h13.5M6 7.5h3v3H6v-3Z" />
      </svg>
      Recent News & Milestones
    </h2>
    <span class="text-xs font-mono text-slate-500 dark:text-slate-400">2024 – 2027</span>
  </div>

  <!-- Scrollable container sized for 5 items capacity -->
  <div class="news-scroll max-h-[460px] sm:max-h-[450px] overflow-y-auto space-y-2 pr-1 sm:pr-1.5 overscroll-y-auto">
    {
      sortedNews.map((item) => (
        <div
          class={`relative flex flex-col sm:flex-row sm:items-start gap-2 sm:gap-3 p-2.5 sm:p-3 rounded-lg border text-xs sm:text-sm transition-all ${
            item.award
              ? 'bg-gradient-to-r from-amber-50/90 via-amber-50/50 to-white dark:from-amber-950/30 dark:via-amber-950/15 dark:to-slate-900/60 border-amber-300/90 dark:border-amber-800/80 shadow-2xs ring-1 ring-amber-400/20'
              : 'bg-white dark:bg-slate-900/70 border-slate-200/80 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700'
          }`}
        >
          <!-- Date / Category column -->
          <div class="flex flex-wrap items-center gap-1.5 flex-shrink-0 sm:w-44 pt-0.5">
            <span
              class={`font-mono text-xs px-2 py-0.5 rounded font-medium ${
                item.award
                  ? 'bg-amber-200/90 text-amber-950 dark:bg-amber-900/70 dark:text-amber-200 font-semibold'
                  : 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300'
              }`}
            >
              {item.year}
            </span>
            {item.pinned && (
              <span class="inline-flex items-center gap-0.5 text-[10px] font-mono font-semibold uppercase px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300 border border-slate-200 dark:border-slate-700 leading-none">
                Pinned
              </span>
            )}
            {item.award && !item.pinned && (
              <span class="inline-flex items-center gap-0.5 text-[11px] font-semibold text-amber-700 dark:text-amber-300">
                <svg width="14" height="14" class="w-3.5 h-3.5 text-amber-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                Award
              </span>
            )}
          </div>

          <!-- Content column -->
          <div class="flex-1 space-y-1">
            <div class="flex flex-wrap items-baseline gap-1.5">
              <span
                class={`font-medium ${
                  item.award ? 'text-amber-950 dark:text-amber-100 font-bold' : 'text-slate-900 dark:text-slate-100 font-semibold'
                }`}
              >
                {item.title}
              </span>
              {item.category === 'paper' && (
                <span class="text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-indigo-50 text-indigo-700 dark:bg-indigo-950/60 dark:text-indigo-300 border border-indigo-200/70 dark:border-indigo-800/60 leading-none">
                  Paper
                </span>
              )}
              {item.category === 'service' && (
                <span class="text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-teal-50 text-teal-700 dark:bg-teal-950/60 dark:text-teal-300 border border-teal-200/70 dark:border-teal-800/60 leading-none">
                  Service
                </span>
              )}
              {item.category === 'award' && (
                <span class="text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-amber-100 text-amber-900 dark:bg-amber-900/60 dark:text-amber-200 border border-amber-300 dark:border-amber-700 leading-none">
                  Distinguished Award
                </span>
              )}
            </div>

            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              {item.description}
            </p>

            {item.links && item.links.length > 0 && (
              <div class="flex flex-wrap items-center gap-1.5 pt-1">
                {item.links.map((link) => (
                  <a href={link.url} target="_blank" rel="noopener noreferrer" class="link-btn">{link.label}</a>
                ))}
              </div>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>
