---
import scholarData from '../data/scholar.json';

const { totalCitations, hIndex, i10Index, profileUrl } = scholarData;
---

<header id="about" class="scroll-mt-20 space-y-6 pt-4">
  <!-- Top Profile Card -->
  <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5 sm:gap-6">
    <div class="relative group flex-shrink-0">
      <picture class="block">
        <source srcset="/avatar.webp" type="image/webp" />
        <img
          src="/avatar.jpg"
          alt="Jipeng Zhang (张吉鹏)"
          width="128"
          height="128"
          class="w-28 h-28 sm:w-32 sm:h-32 rounded-2xl object-cover ring-2 ring-slate-200 dark:ring-slate-700/80 shadow-xs"
          loading="eager"
          decoding="async"
        />
      </picture>
      <div class="absolute inset-0 rounded-2xl ring-1 ring-inset ring-black/5 dark:ring-white/10 pointer-events-none"></div>
    </div>

    <div class="flex-1 text-center sm:text-left space-y-2.5">
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50 flex flex-wrap items-baseline justify-center sm:justify-start gap-2 sm:gap-3">
          <span>Jipeng Zhang</span>
          <span class="text-lg sm:text-xl font-normal text-slate-500 dark:text-slate-400 font-serif">张吉鹏</span>
        </h1>
        <p class="text-xs uppercase tracking-wider font-mono text-indigo-600 dark:text-indigo-400 mt-0.5">
          Postdoctoral Research Fellow · Cryptography & ZKP
        </p>
      </div>

      <!-- Affiliation and Education summary -->
      <div class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 space-y-1">
        <p>
          Postdoctoral Research Fellow at
          <a
            href="https://www.nus.edu.sg"
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-slate-900 dark:text-slate-100 hover:text-indigo-600 dark:hover:text-indigo-400 underline decoration-slate-300 dark:decoration-slate-700 underline-offset-2 transition-colors"
          >National University of Singapore (NUS)</a>,
          working with
          <a
            href="https://zjhzjh123.github.io/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-indigo-600 dark:text-indigo-400 hover:underline underline-offset-2 transition-colors"
          >Prof. Jiaheng Zhang</a>.
        </p>
        <p>
          Ph.D. from
          <a
            href="http://www.nuaa.edu.cn/main.htm"
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-slate-900 dark:text-slate-100 hover:text-indigo-600 dark:hover:text-indigo-400 underline decoration-slate-300 dark:decoration-slate-700 underline-offset-2 transition-colors"
          >Nanjing University of Aeronautics and Astronautics (NUAA)</a>,
          advised by
          <a
            href="https://koclab.net/koc.html"
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-indigo-600 dark:text-indigo-400 hover:underline underline-offset-2 transition-colors"
          >Prof. Çetin Kaya Koç</a>.
        </p>
      </div>

      <!-- Google Scholar Citation Badge -->
      <div class="pt-0.5 flex justify-center sm:justify-start">
        <a
          href={profileUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex flex-wrap items-center gap-2 sm:gap-2.5 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/90 shadow-2xs hover:border-indigo-400 dark:hover:border-indigo-500 hover:bg-indigo-50/30 dark:hover:bg-indigo-950/20 transition-all text-xs group"
          title="Open Google Scholar Profile in new tab"
        >
          <div class="flex items-center gap-1.5 text-indigo-600 dark:text-indigo-400 font-medium">
            <svg width="16" height="16" class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 10a8 8 0 0 1 7.162 3.44L24 9.5 12 0z"/>
            </svg>
            <span class="font-semibold text-slate-800 dark:text-slate-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
              Google Scholar
            </span>
          </div>

          <div class="h-3 w-px bg-slate-200 dark:bg-slate-700 hidden sm:block"></div>

          <div class="flex items-center gap-2 text-slate-600 dark:text-slate-400 text-[11px] sm:text-xs">
            <span>Citations <strong class="text-slate-900 dark:text-slate-100 font-semibold">{totalCitations}</strong></span>
            <span class="text-slate-300 dark:text-slate-700">·</span>
            <span>h-index <strong class="text-slate-900 dark:text-slate-100 font-semibold">{hIndex}</strong></span>
            <span class="text-slate-300 dark:text-slate-700">·</span>
            <span>i10-index <strong class="text-slate-900 dark:text-slate-100 font-semibold">{i10Index}</strong></span>
          </div>

          <svg width="12" height="12" class="w-3 h-3 text-slate-400 group-hover:text-indigo-500 group-hover:translate-x-0.5 transition-all ml-0.5 hidden sm:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
          </svg>
        </a>
      </div>

      <!-- High-Density Text Hyperlinks -->
      <nav aria-label="Academic Profiles and Contact Links" class="pt-0.5 flex flex-wrap items-center justify-center sm:justify-start gap-x-2 gap-y-1 text-xs font-mono text-slate-600 dark:text-slate-400">
        <a href="https://scholar.google.com/citations?hl=en&user=dL1IM-M9ltIC" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Google Scholar</a>
        <span class="text-slate-300 dark:text-slate-700">·</span>
        <a href="https://dblp.org/pid/245/3547-1.html" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">DBLP</a>
        <span class="text-slate-300 dark:text-slate-700">·</span>
        <a href="https://github.com/Ji-Peng" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">GitHub</a>
        <span class="text-slate-300 dark:text-slate-700">·</span>
        <a href="https://orcid.org/0000-0002-0679-7212" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">ORCID</a>
        <span class="text-slate-300 dark:text-slate-700">·</span>
        <a href="mailto:jp-zhang@outlook.com" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Email</a>
        <span class="text-slate-300 dark:text-slate-700">·</span>
        <a href="/uploads/phd/thesis.pdf" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">PhD Thesis</a>
      </nav>
    </div>
  </div>

  <!-- Bio & Research Overview (High information density) -->
  <div class="space-y-3 pt-2">
    <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed text-left sm:text-justify">
      I am currently a Postdoctoral Research Fellow at the <strong>National University of Singapore (NUS)</strong>, working with <strong>Prof. Jiaheng Zhang</strong>. I received my Ph.D. in 2025 under the supervision of <strong>Prof. Çetin Kaya Koç</strong> at Nanjing University of Aeronautics and Astronautics (NUAA), China, where I also obtained my B.Sc. in 2020. My research primarily focuses on <strong>cryptographic engineering</strong>, <strong>zero-knowledge proofs (ZKP)</strong>, <strong>post-quantum cryptography (PQC)</strong>, <strong>elliptic curve cryptography (ECC)</strong>, and <strong>hardware-software co-design</strong> across modern CPUs (AVX-512, RVV, NEON), GPUs, and custom hardware accelerators.
    </p>

    <!-- Research Interest Badges (Compact single line) -->
    <div class="flex flex-wrap items-center gap-1.5 pt-1">
      <span class="text-xs font-mono font-medium text-slate-500 dark:text-slate-400 mr-0.5">Interests:</span>
      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 dark:bg-slate-800/90 text-slate-700 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700/80">
        Cryptographic Engineering
      </span>
      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 dark:bg-slate-800/90 text-slate-700 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700/80">
        Zero-Knowledge Proofs
      </span>
      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 dark:bg-slate-800/90 text-slate-700 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700/80">
        Post-Quantum Cryptography
      </span>
    </div>
  </div>
</header>
