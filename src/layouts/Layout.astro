---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  author?: string;
}

const {
  title = 'Jipeng Zhang (张吉鹏) - Academic Homepage',
  description = 'Dr. Jipeng Zhang is a Postdoctoral Research Fellow at National University of Singapore (NUS) working on Zero-Knowledge Proofs (ZKP), Post-Quantum Cryptography (PQC), Elliptic Curve Cryptography (ECC), and hardware-software co-design.',
  author = 'Jipeng Zhang',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://ji-peng.github.io');
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta
      name="keywords"
      content="Jipeng Zhang, 张吉鹏, Cryptography, Zero-Knowledge Proofs, ZKP, Post-Quantum Cryptography, PQC, Elliptic Curve Cryptography, Hardware Security, RISC-V, AVX-512, NUS, NUAA"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://ji-peng.com/avatar.jpg" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://ji-peng.com/avatar.jpg" />

    <!-- Theme Color for Mobile Browsers -->
    <meta name="theme-color" content="#f4f6fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0d14" media="(prefers-color-scheme: dark)" />

    <!-- Schema.org JSON-LD Structured Data for Academic Indexing -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Jipeng Zhang",
        "alternateName": "张吉鹏",
        "url": "https://ji-peng.com",
        "image": "https://ji-peng.com/avatar.jpg",
        "jobTitle": "Postdoctoral Research Fellow",
        "worksFor": {
          "@type": "EducationalOrganization",
          "name": "National University of Singapore",
          "url": "https://www.nus.edu.sg"
        },
        "alumniOf": {
          "@type": "EducationalOrganization",
          "name": "Nanjing University of Aeronautics and Astronautics",
          "url": "http://www.nuaa.edu.cn"
        },
        "knowsAbout": [
          "Cryptographic Engineering",
          "Zero-Knowledge Proofs",
          "Post-Quantum Cryptography",
          "Elliptic Curve Cryptography",
          "Hardware-Software Co-design"
        ],
        "sameAs": [
          "https://scholar.google.com/citations?user=dL1IM-M9ltIC&hl=en",
          "https://dblp.org/pid/245/3547-1.html",
          "https://github.com/Ji-Peng",
          "https://orcid.org/0000-0002-0679-7212"
        ]
      }
    </script>

    <!-- Theme Initialization Script (Zero-Flash, Explicit Icon Sync & 300ms Debounce) -->
    <script is:inline>
      (function () {
        function syncUI(isDark) {
          if (isDark) {
            document.documentElement.classList.add('dark');
            if (document.body) document.body.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
            if (document.body) document.body.classList.remove('dark');
          }

          var sun = document.getElementById('sun-icon');
          var moon = document.getElementById('moon-icon');
          if (sun) sun.style.display = isDark ? 'block' : 'none';
          if (moon) moon.style.display = isDark ? 'none' : 'block';
        }

        var isDark = false;
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'dark') {
            isDark = true;
          } else if (stored === 'light') {
            isDark = false;
          } else {
            isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          }
        } catch (e) {}

        syncUI(isDark);

        var lastClickTime = 0;
        window.__toggleTheme = function () {
          var now = Date.now();
          if (now - lastClickTime < 300) return; // Prevent duplicate rapid clicks
          lastClickTime = now;

          var currentlyDark = document.documentElement.classList.contains('dark');
          var nextDark = !currentlyDark;
          syncUI(nextDark);
          try {
            localStorage.setItem('theme', nextDark ? 'dark' : 'light');
          } catch (e) {}
        };

        // Re-sync icons when DOM is fully parsed
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function () {
            var curr = document.documentElement.classList.contains('dark');
            syncUI(curr);
          });
        }
      })();
    </script>
  </head>
  <body class="font-sans text-slate-800 antialiased dark:text-slate-100 min-h-screen">
    <!-- Liquid glass: soft colourful backdrop behind every glass surface -->
    <div class="liquid-backdrop" aria-hidden="true"></div>

    <!-- SVG refraction filter (used only by .glass-refract on Chromium) -->
    <svg width="0" height="0" style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true" focusable="false">
      <filter id="liquid-glass-refract" x="0" y="0" width="100%" height="100%" filterUnits="objectBoundingBox" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.012 0.03" numOctaves="1" seed="7" result="noise" />
        <feGaussianBlur in="noise" stdDeviation="2.5" result="map" />
        <feDisplacementMap in="SourceGraphic" in2="map" scale="28" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <!-- Floating glass capsule navigation -->
    <header class="site-nav sticky top-0 z-50 max-w-5xl mx-auto px-2.5 sm:px-6 lg:px-8 pt-2 sm:pt-3">
      <div class="glass-strong glass-refract h-12 pl-3.5 pr-1.5 sm:pl-5 sm:pr-2 rounded-full flex items-center justify-between gap-2 sm:gap-4">
        <!-- Site Title / Home Link -->
        <a
          href="#about"
          class="font-bold text-sm sm:text-base tracking-tight text-slate-900 dark:text-slate-100 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors max-[359px]:hidden flex items-center gap-1.5 whitespace-nowrap min-w-0 overflow-hidden"
        >
          <span class="font-bold truncate">Jipeng Zhang</span>
          <span class="text-xs font-normal text-slate-500 dark:text-slate-400 hidden xs:inline font-serif">张吉鹏</span>
        </a>

        <!-- Navigation Links & Theme Toggle -->
        <div class="flex items-center gap-1 sm:gap-1.5">
          <nav aria-label="Main Navigation" class="flex items-center gap-0 sm:gap-0.5 text-xs sm:text-sm font-medium">
            <a href="#about" data-nav-link class="glass-nav-link px-2 sm:px-2.5">About</a>
            <a href="#news" data-nav-link class="glass-nav-link px-2 sm:px-2.5">News</a>
            <a href="#publications" data-nav-link class="glass-nav-link px-2 sm:px-2.5">
              <span class="hidden xs:inline">Publications</span>
              <span class="xs:hidden">Pubs</span>
            </a>
            <a href="#activities" data-nav-link class="glass-nav-link px-2 sm:px-2.5">
              <span class="hidden xs:inline">Activities</span>
              <span class="xs:hidden">Service</span>
            </a>
          </nav>

          <!-- Divider -->
          <div class="glass-divider-v h-5 mx-0.5 sm:mx-1" aria-hidden="true"></div>

          <!-- Theme Toggle Button -->
          <button
            type="button"
            id="theme-toggle-btn"
            onclick="window.__toggleTheme && window.__toggleTheme()"
            aria-label="Toggle light and dark theme"
            class="glass-icon-btn flex-shrink-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500"
            title="Toggle theme"
          >
            <!-- Sun icon (shown in dark mode) -->
            <svg
              id="sun-icon"
              width="16"
              height="16"
              class="w-4 h-4 text-amber-400 pointer-events-none"
              style="display: none;"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
            </svg>
            <!-- Moon icon (shown in light mode) -->
            <svg
              id="moon-icon"
              width="16"
              height="16"
              class="w-4 h-4 text-slate-700 pointer-events-none"
              style="display: none;"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-4xl sm:max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 space-y-10">
      <slot />
    </main>

    <!-- Minimalist Academic Footer (glass) -->
    <footer class="max-w-4xl sm:max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mt-16 pb-8 text-xs text-slate-600 dark:text-slate-400">
      <div class="glass rounded-2xl px-4 sm:px-5 py-3.5 flex flex-col sm:flex-row items-center justify-between gap-2 sm:gap-3 text-center sm:text-left">
        <p>
          &copy; {new Date().getFullYear()} Jipeng Zhang (张吉鹏). All rights reserved.
        </p>
        <p class="font-mono text-[11px] text-slate-500 dark:text-slate-400">
          Last updated: September 2026 · Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="hover:underline text-slate-700 dark:text-slate-300">Astro</a> &amp; <a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer" class="hover:underline text-slate-700 dark:text-slate-300">Tailwind CSS</a> · <a href="https://github.com/Ji-Peng/MyPage" target="_blank" rel="noopener noreferrer" class="hover:underline text-indigo-600 dark:text-indigo-400">GitHub Source</a>
        </p>
      </div>
    </footer>

    <!-- Liquid glass enhancements: Chromium-only refraction flag and nav scroll-spy -->
    <script is:inline>
      (function () {
        try {
          if (navigator.userAgentData && window.CSS && CSS.supports('backdrop-filter', 'url(#liquid-glass-refract)')) {
            document.documentElement.classList.add('lg-refract');
          }
        } catch (e) {}

        if (!('IntersectionObserver' in window)) return;
        var links = document.querySelectorAll('[data-nav-link]');
        var map = {};
        links.forEach(function (a) { map[a.getAttribute('href').slice(1)] = a; });
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting || !map[e.target.id]) return;
            links.forEach(function (a) { a.removeAttribute('aria-current'); });
            map[e.target.id].setAttribute('aria-current', 'true');
          });
        }, { rootMargin: '-35% 0px -60% 0px' });
        Object.keys(map).forEach(function (id) {
          var el = document.getElementById(id);
          if (el) io.observe(el);
        });
      })();
    </script>
  </body>
</html>
