---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  author?: string;
}

const {
  title = 'Jipeng Zhang (张吉鹏) - Academic Homepage',
  description = 'Dr. Jipeng Zhang is a Postdoctoral Research Fellow at National University of Singapore (NUS) working on Zero-Knowledge Proofs (ZKP), Post-Quantum Cryptography (PQC), Elliptic Curve Cryptography (ECC), and hardware-software co-design.',
  author = 'Jipeng Zhang',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://ji-peng.github.io');
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta
      name="keywords"
      content="Jipeng Zhang, 张吉鹏, Cryptography, Zero-Knowledge Proofs, ZKP, Post-Quantum Cryptography, PQC, Elliptic Curve Cryptography, Hardware Security, RISC-V, AVX-512, NUS, NUAA"
    />

    <!-- Google Scholar Indexing Meta Tags -->
    <meta name="citation_author" content="Jipeng Zhang" />
    <meta name="citation_title" content="Dr. Jipeng Zhang - Academic Homepage & Research" />
    <meta
      name="citation_keywords"
      content="Zero-Knowledge Proofs, Post-Quantum Cryptography, Elliptic Curve Cryptography, Cryptographic Engineering, Hardware Security, RISC-V, AVX-512"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/avatar.jpg" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/avatar.jpg" />

    <!-- Theme Color for Mobile Browsers -->
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0f19" media="(prefers-color-scheme: dark)" />

    <!-- Schema.org JSON-LD Structured Data for Academic Indexing -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Jipeng Zhang",
        "alternateName": "张吉鹏",
        "url": "https://ji-peng.com",
        "image": "https://ji-peng.com/avatar.jpg",
        "jobTitle": "Postdoctoral Research Fellow",
        "worksFor": {
          "@type": "EducationalOrganization",
          "name": "National University of Singapore",
          "url": "https://www.nus.edu.sg"
        },
        "alumniOf": {
          "@type": "EducationalOrganization",
          "name": "Nanjing University of Aeronautics and Astronautics",
          "url": "http://www.nuaa.edu.cn"
        },
        "knowsAbout": [
          "Cryptographic Engineering",
          "Zero-Knowledge Proofs",
          "Post-Quantum Cryptography",
          "Elliptic Curve Cryptography",
          "Hardware-Software Co-design"
        ],
        "sameAs": [
          "https://scholar.google.com/citations?user=dL1IM-M9ltIC&hl=en",
          "https://dblp.org/pid/245/3547-1.html",
          "https://github.com/Ji-Peng",
          "https://orcid.org/0000-0002-0679-7212"
        ]
      }
    </script>

    <!-- Theme Initialization Script (Zero-Flash, Explicit Icon Sync & 300ms Debounce) -->
    <script is:inline>
      (function () {
        function syncUI(isDark) {
          if (isDark) {
            document.documentElement.classList.add('dark');
            if (document.body) document.body.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
            if (document.body) document.body.classList.remove('dark');
          }

          var sun = document.getElementById('sun-icon');
          var moon = document.getElementById('moon-icon');
          if (sun) sun.style.display = isDark ? 'block' : 'none';
          if (moon) moon.style.display = isDark ? 'none' : 'block';
        }

        var isDark = false;
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'dark') {
            isDark = true;
          } else if (stored === 'light') {
            isDark = false;
          } else {
            isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          }
        } catch (e) {}

        syncUI(isDark);

        var lastClickTime = 0;
        window.__toggleTheme = function () {
          var now = Date.now();
          if (now - lastClickTime < 300) return; // Prevent duplicate rapid clicks
          lastClickTime = now;

          var currentlyDark = document.documentElement.classList.contains('dark');
          var nextDark = !currentlyDark;
          syncUI(nextDark);
          try {
            localStorage.setItem('theme', nextDark ? 'dark' : 'light');
          } catch (e) {}
        };

        // Re-sync icons when DOM is fully parsed
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function () {
            var curr = document.documentElement.classList.contains('dark');
            syncUI(curr);
          });
        }
      })();
    </script>
  </head>
  <body class="font-sans bg-slate-50 text-slate-800 antialiased dark:bg-[#0b0f19] dark:text-slate-100 min-h-screen transition-colors duration-200">
    <!-- Top Sleek Navigation Bar -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-white/85 dark:bg-slate-900/85 border-b border-slate-200/80 dark:border-slate-800/80 transition-colors">
      <div class="max-w-4xl sm:max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between gap-4">
        <!-- Site Title / Home Link -->
        <a
          href="#about"
          class="font-bold text-base tracking-tight text-slate-900 dark:text-slate-100 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors flex items-center gap-1.5"
        >
          <span class="font-bold">Jipeng Zhang</span>
          <span class="text-xs font-normal text-slate-500 dark:text-slate-400 hidden xs:inline font-serif">张吉鹏</span>
        </a>

        <!-- Navigation Links & Theme Toggle -->
        <div class="flex items-center gap-1 sm:gap-2">
          <nav aria-label="Main Navigation" class="flex items-center gap-0.5 sm:gap-1 text-xs sm:text-sm font-medium">
            <a
              href="#about"
              class="px-2 sm:px-2.5 py-1.5 rounded-md text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100/80 dark:hover:bg-slate-800/80 transition-all"
            >
              About
            </a>
            <a
              href="#news"
              class="px-2 sm:px-2.5 py-1.5 rounded-md text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100/80 dark:hover:bg-slate-800/80 transition-all"
            >
              News
            </a>
            <a
              href="#publications"
              class="px-2 sm:px-2.5 py-1.5 rounded-md text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100/80 dark:hover:bg-slate-800/80 transition-all"
            >
              <span class="hidden xs:inline">Publications</span>
              <span class="xs:hidden">Pubs</span>
            </a>
            <a
              href="#activities"
              class="px-2 sm:px-2.5 py-1.5 rounded-md text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100/80 dark:hover:bg-slate-800/80 transition-all"
            >
              <span class="hidden xs:inline">Activities</span>
              <span class="xs:hidden">Service</span>
            </a>
          </nav>

          <!-- Divider -->
          <div class="h-4 w-px bg-slate-200 dark:bg-slate-700 mx-1"></div>

          <!-- Theme Toggle Button -->
          <button
            type="button"
            id="theme-toggle-btn"
            onclick="window.__toggleTheme && window.__toggleTheme()"
            aria-label="Toggle light and dark theme"
            class="p-1.5 rounded-md text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer"
            title="Toggle theme"
          >
            <!-- Sun icon (shown in dark mode) -->
            <svg
              id="sun-icon"
              width="16"
              height="16"
              class="w-4 h-4 text-amber-400 pointer-events-none"
              style="display: none;"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
            </svg>
            <!-- Moon icon (shown in light mode) -->
            <svg
              id="moon-icon"
              width="16"
              height="16"
              class="w-4 h-4 text-slate-700 pointer-events-none"
              style="display: none;"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-4xl sm:max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 space-y-12">
      <slot />
    </main>

    <!-- Minimalist Academic Footer -->
    <footer class="max-w-4xl sm:max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12 mt-16 border-t border-slate-200/80 dark:border-slate-800 text-xs text-slate-500 dark:text-slate-400">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
        <p>
          &copy; {new Date().getFullYear()} Jipeng Zhang (张吉鹏). All rights reserved.
        </p>
        <p class="font-mono text-[11px] text-slate-400 dark:text-slate-500">
          Last updated: September 2026 · Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="hover:underline text-slate-600 dark:text-slate-300">Astro</a> &amp; <a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer" class="hover:underline text-slate-600 dark:text-slate-300">Tailwind CSS</a> · <a href="https://github.com/Ji-Peng/MyPage" target="_blank" rel="noopener noreferrer" class="hover:underline text-indigo-600 dark:text-indigo-400">GitHub Source</a>
        </p>
      </div>
    </footer>
  </body>
</html>
